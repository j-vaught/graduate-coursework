\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{emch574-homework}[2026/09/01 General EMCH 574 homework style]

\RequirePackage[margin=1in]{geometry}
\RequirePackage{fontspec}
\RequirePackage{amsmath}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{hyperref}
\RequirePackage{microtype}
\RequirePackage{booktabs}
\RequirePackage{array}

\setmainfont{STIX Two Text}

\definecolor{garnet}{HTML}{73000A}
\definecolor{charcoal}{HTML}{363636}
\definecolor{lightgray}{HTML}{ECECEC}

\newcommand{\thehomeworknumber}{00}
\newcommand{\thestudentname}{J.C. Vaught}
\newcommand{\theduedate}{TBD}
\newcommand{\homeworknumber}[1]{\renewcommand{\thehomeworknumber}{#1}}
\newcommand{\studentname}[1]{\renewcommand{\thestudentname}{#1}}
\newcommand{\duedate}[1]{\renewcommand{\theduedate}{#1}}

\newcommand{\makehomeworktitle}{%
  \begin{center}
    {\color{garnet}\rule{\linewidth}{1.5pt}}\\[0.8em]
    {\Large\bfseries EMCH 574 -- Vibration and Waves}\\[0.45em]
    {\LARGE\bfseries Homework \thehomeworknumber}\\[0.8em]
    \begin{tabular}{@{}ll@{}}
      Student & \thestudentname \\
      Due date & \theduedate
    \end{tabular}\\[0.8em]
    {\color{garnet}\rule{\linewidth}{1.5pt}}
  \end{center}
  \vspace{0.8em}
}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{EMCH 574}
\fancyhead[R]{Homework \thehomeworknumber}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

\titleformat{\section}{\Large\bfseries\color{garnet}}{\thesection}{0.6em}{}
\titleformat{\subsection}{\large\bfseries\color{charcoal}}{}{0em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\color{charcoal}}{}{0em}{}
\titlespacing*{\section}{0pt}{1.5em}{0.6em}
\titlespacing*{\subsection}{0pt}{1.2em}{0.4em}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.35em}
\setlength{\headheight}{14pt}
\hypersetup{colorlinks=true, linkcolor=garnet, urlcolor=garnet}
\emergencystretch=2em

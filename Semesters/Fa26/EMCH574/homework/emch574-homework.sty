\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{emch574-homework}[2026/09/01 General EMCH 574 homework style]

\RequirePackage[margin=1in]{geometry}
\RequirePackage{amsmath}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{hyperref}
\RequirePackage{microtype}
\RequirePackage{booktabs}
\RequirePackage{array}

\definecolor{emchteal}{HTML}{006D75}
\definecolor{charcoal}{HTML}{363636}
\definecolor{lightgray}{HTML}{ECECEC}

\newcommand{\thehomeworknumber}{00}
\newcommand{\thestudentname}{J.C. Vaught}
\newcommand{\thestudentstatus}{Graduate}
\newcommand{\theduedate}{TBD}
\newcommand{\homeworknumber}[1]{\renewcommand{\thehomeworknumber}{#1}}
\newcommand{\studentname}[1]{\renewcommand{\thestudentname}{#1}}
\newcommand{\studentstatus}[1]{\renewcommand{\thestudentstatus}{#1}}
\newcommand{\duedate}[1]{\renewcommand{\theduedate}{#1}}

\newcommand{\makehomeworktitle}{%
  \begin{center}
    {\color{emchteal}\rule{\linewidth}{1.5pt}}\\[0.8em]
    {\Large\bfseries EMCH 574 -- Vibration and Waves}\\[0.45em]
    {\LARGE\bfseries Homework \thehomeworknumber}\\[0.8em]
    \begin{tabular}{@{}ll@{}}
      Student & \thestudentname \\
      Due date & \theduedate
    \end{tabular}\\[0.8em]
    {\color{emchteal}\rule{\linewidth}{1.5pt}}
  \end{center}
  \vspace{0.8em}
}

% A small family of hanging-label commands keeps the source readable and gives
% every question level a stable visual rhythm without fragile manual breaks.
\newcommand{\questionitem}[2]{%
  \par\addvspace{0.28em}%
  \begingroup
  \noindent\hangindent=2.65em\hangafter=1%
  \makebox[2.45em][l]{\bfseries (#1)}#2\par
  \endgroup
}
\newcommand{\subquestionitem}[2]{%
  \par\addvspace{0.12em}%
  \begingroup
  \leftskip=1.55em\relax
  \noindent\hangindent=2.35em\hangafter=1%
  \makebox[2.15em][l]{\bfseries (#1)}#2\par
  \endgroup
}
\newcommand{\detailitem}[2]{%
  \par\addvspace{0.08em}%
  \begingroup
  \leftskip=3.1em\relax
  \noindent\hangindent=2.45em\hangafter=1%
  \makebox[2.25em][l]{\bfseries (#1)}#2\par
  \endgroup
}
\newcommand{\bulletitem}[1]{%
  \par\addvspace{0.12em}%
  \begingroup
  \leftskip=1.55em\relax
  \noindent\hangindent=1.4em\hangafter=1%
  \makebox[1.2em][l]{\textbullet}#1\par
  \endgroup
}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{EMCH 574; Homework \thehomeworknumber}
\fancyhead[R]{\thestudentname; \thestudentstatus}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

\titleformat{\section}{\rmfamily\Large\bfseries\color{emchteal}}{\thesection}{0.6em}{}
\titleformat{\subsection}{\rmfamily\large\bfseries\color{charcoal}}{}{0em}{}
\titleformat{\subsubsection}{\rmfamily\normalsize\bfseries\color{charcoal}}{}{0em}{}
\titlespacing*{\section}{0pt}{1.5em}{0.6em}
\titlespacing*{\subsection}{0pt}{1.2em}{0.4em}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.35em}
\setlength{\headheight}{14pt}
\AtBeginDocument{%
  \everymath{\color{emchteal}}%
  \everydisplay{\color{emchteal}}%
}
\hypersetup{colorlinks=true, linkcolor=emchteal, urlcolor=emchteal}
\emergencystretch=2em

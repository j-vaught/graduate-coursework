clc
clear all

sym y f; 

Caf=0; Car=0; m=0.538; Vx=1; lf=0.0979; lr=0.0926; Iz=0.004676;

matrix1 = [0, 1, 0, 0;...
           0, -(2*Caf+2*Car)/(m*Vx), 0, -Vx-(2*lf*Caf-2*lr*Car)/(m*Vx);...
           0, 0, 0, 1;...
           0, -(2*lf*Caf-2*lr*Car)/(Iz*Vx), 0, -(2*((lf)^2)*Caf+2*((lr)^2)*Car)/(Iz*Vx)];
matrix2 = [y; diff(y); f; diff(f)];
matrix3 = [0; (2*Caf)/m; 0; (2*lf*Caf)/Iz];
matrix4 = (matrix1*matrix2) + matrix3*delta;
